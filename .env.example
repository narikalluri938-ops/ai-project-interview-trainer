# AI Project Interview Trainer - Environment Configuration Template
# Copy this file to .env and fill in your values. Do not commit .env to version control.

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=

# Database Connection (SQLite local or PostgreSQL in production)
# Examples:
#   SQLite:     sqlite:///instance/interview_trainer.db
#   PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=

# AI Provider Configuration (mock | gemini | openai)
# Use 'mock' to run 100% offline without any API keys or external costs
AI_PROVIDER=mock

# AI API Key (leave blank when using AI_PROVIDER=mock)
AI_API_KEY=

# Model Name (e.g. gemini-2.5-flash for Gemini, gpt-4o-mini for OpenAI)
AI_MODEL=
